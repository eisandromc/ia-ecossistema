# Configuração do painel. O arquivo .env fica só na sua máquina (está no .gitignore).
# O painel relê este arquivo sozinho: edite, salve e clique em "Recarregar .env".

# ---------------------------------------------------------------------------
# 1. Chaves de API. Preencha só as que for usar.
# Sem nenhuma chave, o painel funciona em modo Simulação, sem custo.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# 2. Servidores locais ou compatíveis com a API da OpenAI. Não exigem chave.
# ---------------------------------------------------------------------------
# Ollama: descomente a linha abaixo com o Ollama aberto.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Qualquer endpoint com /chat/completions: LM Studio, Azure OpenAI, vLLM...
# CUSTOM_BASE_URL=http://localhost:1234/v1
# CUSTOM_API_KEY=
# CUSTOM_MODELOS=meu-modelo
# Use api-key no lugar de bearer para o Azure OpenAI.
# CUSTOM_KEY_HEADER=bearer

# ---------------------------------------------------------------------------
# 3. Modelos que aparecem na lista (opcional).
# O painel já busca a lista real no provedor; use isto para destacar seus
# favoritos no topo ou para incluir um modelo que o provedor não lista.
# ---------------------------------------------------------------------------
# ANTHROPIC_MODELOS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# OPENAI_MODELOS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
# GEMINI_MODELOS=
# MISTRAL_MODELOS=mistral-large-latest,mistral-small-latest
# GROQ_MODELOS=
# DEEPSEEK_MODELOS=deepseek-v4-pro,deepseek-v4-flash
# XAI_MODELOS=
# OPENROUTER_MODELOS=openrouter/auto

# ---------------------------------------------------------------------------
# 4. Qual modelo cada nível da hierarquia usa, no formato provedor:modelo.
# Provedores: anthropic, openai, gemini, mistral, groq, deepseek, xai,
# openrouter, ollama, custom. Use "simulacao" para não gastar nada naquele nível.
#
# A chave conecta o provedor, mas o modelo só entra em uso depois de ativado na aba
# Conexão. Os modelos citados nesta seção já contam como ativados.
# Vazio em MODELO_PADRAO: usa o primeiro modelo ativado, ou a Simulação.
# Vazio em um nível: usa MODELO_PADRAO.
# A aba Conexão do painel pode sobrepor estes valores, sem alterar este arquivo.
# ---------------------------------------------------------------------------
MODELO_PADRAO=
# MODELO_DOMINIO=anthropic:claude-haiku-5-5
# MODELO_ORQUESTRADOR=anthropic:claude-sonnet-5-5
# MODELO_MULTIAGENTES=openai:gpt-5.6-sol
# MODELO_WORKFLOW=anthropic:claude-sonnet-5-5
# MODELO_AGENTE=anthropic:claude-opus-5-5
# MODELO_SUBAGENTE=ollama:llama3.1
# MODELO_FABRICA=anthropic:claude-opus-5-5

# ---------------------------------------------------------------------------
# 5. Servidor e limites
# ---------------------------------------------------------------------------
PORTA=3210
PAINEL_ABRIR_NAVEGADOR=true
# O botão Carregar, na aba Conexão, atualiza esta linha.
ECOSSISTEMA_DIR=../ecossistema-educacional
# Máximo de tokens de saída por chamada e tempo limite de cada chamada.
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_MS=300000
